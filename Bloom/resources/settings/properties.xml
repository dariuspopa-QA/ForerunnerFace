<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- 0 Rose, 1 Sage, 2 Sky, 3 Coral, 4 Gold, 5 Lilac, 6 Aqua, 7 Pearl -->
    <property id="Palette" type="number">0</property>
    <!-- Hex colour (E86A8A) for the bloom instead of the palette; empty = palette -->
    <property id="CustomColor" type="string"></property>
    <!-- Colour of the lowest value -->
    <property id="Highlight" type="number">0xFF8A3D</property>
    <!-- 0 watch (from distance units), 1 MON 28 SEP, 2 DD-MM-YYYY, 3 MM-DD-YYYY -->
    <property id="DateFormat" type="number">0</property>
</properties>

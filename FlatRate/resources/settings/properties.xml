<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <property id="AccentColor" type="number">0xD7FF1F</property>
    <!-- 0 watch (from distance units), 1 MON 28 SEP, 2 DD-MM-YYYY, 3 MM-DD-YYYY -->
    <property id="DateFormat" type="number">1</property>
    <!-- shift start and break in minutes after midnight (break -1 = none), length in minutes -->
    <property id="ShiftStart" type="number">420</property>
    <property id="ShiftLength" type="number">480</property>
    <property id="BreakTime" type="number">720</property>
    <!-- repair order number on the top line, 0 hides it -->
    <property id="RepairOrder" type="number">0</property>
    <property id="Bay" type="number">3</property>
    <property id="JobName" type="string">ON THE CLOCK</property>
</properties>
